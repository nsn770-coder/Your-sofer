# ─────────────────────────────────────────────────────────────────────────────
# scripts/google-ads/pmax-event-kippot — משתני סביבה
#
# שמות בלבד. אין כאן ערכים אמיתיים ואסור לשים כאן ערכים אמיתיים.
# את הערכים יש להוסיף ל-.env.local (שנמצא ב-.gitignore) או ל-Vercel.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Ads API ────────────────────────────────────────────────────────────
# Developer token מחשבון ה-MCC (API Center)
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth2 desktop client מ-Google Cloud Console
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Refresh token שנוצר פעם אחת מול scope https://www.googleapis.com/auth/adwords
GOOGLE_ADS_REFRESH_TOKEN=
# חשבון המודעות שבו נוצר הקמפיין (ספרות בלבד או עם מקפים — שניהם עובדים)
GOOGLE_ADS_CUSTOMER_ID=
# חשבון ה-MCC המנהל, אם הגישה עוברת דרכו. אפשר להשאיר ריק.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ── Google Merchant Center ────────────────────────────────────────────────────
# מזהה חשבון המרצ'נט שמחובר לחשבון המודעות (check-account.mjs מדפיס אותו)
GOOGLE_MERCHANT_ID=
# feed label / country של הפיד. ריק = ברירת המחדל של החשבון.
GOOGLE_MERCHANT_FEED_LABEL=

# ── תקציב ובידינג — הסקריפט לא מנחש ─────────────────────────────────────────
# תקציב יומי בשקלים, למשל 60
DAILY_BUDGET_ILS=
# יעד ROAS כיחס: 2.5 = 250%. השאר ריק כדי לרוץ Maximize Conversion Value ללא יעד.
TARGET_ROAS=

# ── Firebase (כבר קיימים בפרויקט — לא להוסיף שוב אם הם ב-.env.local) ────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
